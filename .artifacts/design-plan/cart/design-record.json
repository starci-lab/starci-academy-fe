  "relationships": [
    {
      "kind": "seam",
      "subject": "cart-line-list",
      "decision": "divide-y with per-row py-3",
      "reason": "the courses are peers already chosen, so one surface with a rule rather than an edge each"
    },
    {
      "kind": "seam",
      "subject": "order-summary-stack",
      "decision": "gap-2, then a rule plus pt-3 and mt-1 above the last child",
      "reason": "the total is a different KIND of line, not the last of a series"
    },
    {
      "kind": "seam",
      "subject": "cart-drawer-column",
      "decision": "own p-4",
      "reason": "the shell passes the interior through without arranging or padding it"
    },
    {
      "kind": "rank",
      "subject": "order-total-row.amount",
      "decision": "md semibold",
      "reason": "the figure actually being asked for is the loudest thing on the surface"
    },
    {
      "kind": "rank",
      "subject": "label-with-muted-fact-row.fact in the summary",
      "decision": "xs muted",
      "reason": "a component of a total ranks below the total"
    },
    {
      "kind": "rank",
      "subject": "CartLine original price",
      "decision": "xs muted, superseded",
      "reason": "two live numbers on one line makes the reader work out which they owe"
    },
    {
      "kind": "rank",
      "subject": "ordered-step-row.value",
      "decision": "xs",
      "reason": "the schedule explains the total rather than restating it"
    },
    {
      "kind": "variant",
      "subject": "line removal",
      "decision": "IconButton, glyph only, trailing edge",
      "reason": "the only destructive thing on the row; its name repeated down a list would be the loudest reading of the action nobody came for"
    },
    {
      "kind": "variant",
      "subject": "clear-all",
      "decision": "ConfirmButton, secondary resting, outline armed",
      "reason": "destructive and whole-basket; the reference arms an inline confirm rather than opening a modal"
    },
    {
      "kind": "variant",
      "subject": "pay-how choice",
      "decision": "ChoiceTabs primary (segmented pill)",
      "reason": "it switches the whole panel rather than filtering a list under it"
    },
    {
      "kind": "variant",
      "subject": "cycle mark",
      "decision": "StatusDot on the due cycle only, resting line elsewhere",
      "reason": "its tones are all affirmative, so there is no honest dot for a cycle that is not due; the slot stays occupied to keep names aligned"
    }
  ],
  "openQuestions": [
    {
      "question": "is line removal words or a glyph",
      "default": "glyph with the accessible name Bo khoi gio",
      "cost": "quieter down a list, possibly too quiet on a basket of one",
      "resolution": "waived",
      "answeredBy": "duyet"
    },
    {
      "question": "does the cart show a running total while pricing is in flight",
      "default": "no - figures rest, rows stay real",
      "cost": "a moment with per-line prices and no total; the alternative is a client-side sum, which is the failure the plan record names",
      "resolution": "waived",
      "answeredBy": "duyet"
    },
    {
      "question": "does the instalment hint appear when pricing failed",
      "default": "no",
      "cost": "the reader loses the knowledge that instalments exist in a state where they might want them",
      "resolution": "waived",
      "answeredBy": "duyet"
    },
    {
      "question": "does removing one line disable the others",
      "default": "no - only the row in flight",
      "cost": "two rapid removals are possible",
      "resolution": "waived",
      "answeredBy": "duyet"
    },
    {
      "question": "does the drawer carry its own heading",
      "default": "no - the shell names it",
      "cost": "mounted without DrawerShell it would lose its name",
      "resolution": "waived",
      "answeredBy": "duyet"
    },
    {
      "question": "does clear-all confirm or empty immediately",
      "default": "inline two-step confirm, no modal",
      "cost": "the armed window can expire between deciding and pressing",
      "resolution": "answered",
      "answeredBy": "the legacy reference ships exactly this mechanic and states the rule beside it"
