# -----------------------------------------------------------------------------
# starci-academy-fe - environment
#
# Copy to `.env.local` and edit. A variable prefixed NEXT_PUBLIC_ is inlined by
# Next.js INTO the browser bundle: anyone with the page open can read the value,
# so nothing secret may carry that prefix.
#
# The last block is the exception and says so: those names have NO prefix and
# are read only by the operator script that seeds a Keycloak test account.
# Everything else is read in exactly one place: src/modules/api/env.ts
# -----------------------------------------------------------------------------

# REQUIRED - the GraphQL endpoint the whole API layer talks to.
# Without it the app falls back to the local API below, which in a deployed
# environment fails silently until someone opens the network tab.
NEXT_PUBLIC_API_GRAPHQL_BASE_URL=http://localhost:3001/graphql

# -----------------------------------------------------------------------------
# Optional transport tuning. Every one of these has a working default; set them
# only when the default is wrong for the environment.
# -----------------------------------------------------------------------------

# Attempts per operation, INCLUDING the first. 1 disables retrying. Default 3.
NEXT_PUBLIC_GRAPHQL_MAX_RETRY=3

# Delay in ms before the first retry; later attempts back off from it. Default 300.
NEXT_PUBLIC_GRAPHQL_INITIAL_RETRY_DELAY=300

# Upper bound in ms for the jittered backoff between attempts. Default 1000.
NEXT_PUBLIC_GRAPHQL_MAX_RETRY_DELAY=1000

# Milliseconds before an unanswered operation is aborted. Default 300000 (5 min).
# Lower this in development to notice a hung API instead of waiting on it.
NEXT_PUBLIC_GRAPHQL_TIMEOUT=300000

# Set to the literal string "false" to silence the link chain's logging.
# Anything else, including unset, leaves logging on.
NEXT_PUBLIC_DEBUG=true

# -----------------------------------------------------------------------------
# Optional public SEO / observability configuration.
#
# Empty values disable their provider-specific output. GA4 is deliberately not
# loaded yet: the greenfield app needs an approved consent owner before any
# analytics request may leave the browser.
# -----------------------------------------------------------------------------

# Absolute production origin used by canonical links, OpenGraph, robots and sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Search Console HTML verification token; empty omits the meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# GA4 Measurement ID reserved for the future consent-gated analytics owner.
NEXT_PUBLIC_GA_ID=

# Sentry runtime values. The DSN is public configuration; an empty DSN disables capture.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_RELEASE=

# Build-only Sentry values belong in CI/deploy secrets, never in a browser-prefixed variable.
SENTRY_ORG=starci-lab-company
SENTRY_PROJECT=starci-web
SENTRY_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# DEVELOPMENT BEARER TOKEN PASS-THROUGH - not a login.
#
# This repository has no session, no Keycloak provider and no token refresh yet.
# When set, this value is attached verbatim as `authorization: Bearer <token>`
# by src/modules/api/graphql/clients/links/bearer.ts, so the authenticated path
# can be proved end to end before a real session exists.
#
# Because it is NEXT_PUBLIC_, it ships to the browser. Use a developer's own
# throwaway token, never a real user's, and never set it in production. Leave it
# unset and every request goes out anonymous, which is the normal case.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BEARER_TOKEN=

# -----------------------------------------------------------------------------
# TEST-ACCOUNT SEED - operator input, never an application login shortcut.
# Read only by scripts/provision-test-account.mjs. The account then signs in
# through the ordinary form like every other Keycloak user.
#
# These values carry NO public prefix on purpose - adding one would compile the
# account into the bundle and hand it to every visitor.
#
# Seed the account in Keycloak first; the token comes from the provider's own
# password grant, so it carries exactly the roles that account was given.
# -----------------------------------------------------------------------------
DEV_TEST_ACCOUNT_EMAIL=
DEV_TEST_ACCOUNT_PASSWORD=

# Where the token is minted - the same realm and client the back end authenticates
# against. Defaults suit the local compose stack; no password here has a default.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=academy-web
KEYCLOAK_CLIENT_SECRET=

# Only `npm run seed:test-account` reads this - the admin of the LOCAL Keycloak
# container, used to create the test account after a container wipe. It is the one
# credential here that opens more than a single account, so it has no default and
# the script refuses to run against anything but a loopback host.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
